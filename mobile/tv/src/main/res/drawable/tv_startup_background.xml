<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <!-- Match the catalog backdrop without a separate loading Activity. -->
            <gradient android:angle="270" android:startColor="#202840"
                android:centerColor="#151726" android:endColor="#10131A" />
