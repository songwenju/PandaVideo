# Local service
APP_HOST=127.0.0.1
APP_PORT=8766

# Doubao / Volcengine Ark
# Create an API key in the Ark console. ARK_MODEL is your endpoint or model ID.
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional public stock providers. Internet Archive works without a key.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Internet Archive is optional because it may be slow or unreachable on some
# networks.
INTERNET_ARCHIVE_ENABLED=false

# 80s movie search is enabled by default and requires no key. Set false to
# disable it if the site is unavailable on the current network.
EIGHTYSGOD_ENABLED=true

# Movie Heaven (dytt8899.com), enabled by default without an API key.
DYTT_ENABLED=true

# Verified Piaohua, Movie Port and 66YS sources; no API key required.
MOVIE_SOURCES_ENABLED=true

# NAS destination used by the mount status and local Xunlei client.
NAS_DOWNLOAD_DIR=/Volumes/video/downloads
NAS_MOUNT_URL=smb://your-user@DS216se.local/video

# Optional local Xunlei client used by the "调用迅雷" button.
XUNLEI_APP_PATH=/Applications/Thunder.app

# Xunlei SSE MCP used for 80s and Movie Heaven search results.
# Create an app at https://pan.xunlei.com/mcp and paste its URL here.
XUNLEI_MCP_URL=
# Optional target ID when the MCP account has multiple download devices.
XUNLEI_MCP_TARGET=
